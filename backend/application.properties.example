# Reference copy; the application loads src/main/resources/application.properties.
# Secrets and connection details are supplied with environment variables.
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/portfolio}
spring.datasource.username=${DB_USERNAME:portfolio}
spring.datasource.password=${DB_PASSWORD:}
spring.datasource.driver-class-name=org.postgresql.Driver
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.jdbc.time_zone=UTC
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=0
server.port=${PORT:8080}
server.forward-headers-strategy=framework
app.jwt.secret=${JWT_SECRET}
app.jwt.expiration-seconds=${JWT_EXPIRATION_SECONDS:86400}
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173}
app.bootstrap.admin-email=${ADMIN_EMAIL:}
app.bootstrap.admin-initial-password=${ADMIN_INITIAL_PASSWORD:}
app.bootstrap.admin-first-name=${ADMIN_FIRST_NAME:Portfolio}
app.bootstrap.admin-last-name=${ADMIN_LAST_NAME:Owner}
